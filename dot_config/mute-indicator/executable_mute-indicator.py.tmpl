#!/usr/bin/env python3
"""Mute indicator overlay using GTK4 + gtk4-layer-shell.

Displays a red LED bar image at the top of every monitor when the mic is muted.
Uses exclusive_zone=-1 so it ignores other surfaces' exclusive zones (e.g. noctalia bar).

Signals:
  SIGUSR1 → show (muted)
  SIGUSR2 → hide (unmuted)
"""

import signal
import subprocess
import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Gtk4LayerShell", "1.0")
from gi.repository import Gtk, Gtk4LayerShell, GLib, Gdk

IMAGE_PATH = "{{ joinPath .chezmoi.homeDir ".config/mute-led/mic_mute_led.svg" }}"
WIDTH = 400


class MuteIndicator(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="com.local.mute-indicator")
        self.windows = []
        self.muted = self._get_mute_state()
        self.monitors = None

    @staticmethod
    def _get_mute_state():
        """Read the initial state; later changes arrive through signals."""
        try:
            result = subprocess.run(
                ["pactl", "get-source-mute", "mic"],
                capture_output=True,
                text=True,
                timeout=2,
                check=False,
            )
            return result.returncode == 0 and "Mute: yes" in result.stdout
        except (OSError, subprocess.TimeoutExpired):
            return False

    def _create_window_for_monitor(self, monitor):
        window = Gtk.ApplicationWindow(application=self)

        # Layer shell setup
        Gtk4LayerShell.init_for_window(window)
        Gtk4LayerShell.set_layer(window, Gtk4LayerShell.Layer.OVERLAY)
        Gtk4LayerShell.set_anchor(window, Gtk4LayerShell.Edge.TOP, True)
        Gtk4LayerShell.set_exclusive_zone(window, -1)
        Gtk4LayerShell.set_namespace(window, "mute-indicator")
        Gtk4LayerShell.set_keyboard_mode(
            window, Gtk4LayerShell.KeyboardMode.NONE
        )
        Gtk4LayerShell.set_monitor(window, monitor)

        # Image
        picture = Gtk.Picture.new_for_filename(IMAGE_PATH)
        picture.set_content_fit(Gtk.ContentFit.CONTAIN)
        picture.set_size_request(WIDTH, -1)
        window.set_child(picture)

        # Start hidden
        window.set_visible(False)
        return window

    def do_activate(self):
        display = Gdk.Display.get_default()

        # Transparent background (once, display-wide)
        css = Gtk.CssProvider()
        css.load_from_string("window { background: transparent; }")
        Gtk.StyleContext.add_provider_for_display(
            display, css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        # Gdk's monitor list is live. Keep one layer-shell window per monitor,
        # including monitors connected after the application started.
        self.monitors = display.get_monitors()
        self.monitors.connect("items-changed", self._sync_monitors)
        self._sync_monitors()

        # Signal handlers
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1, self._show)
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR2, self._hide)

    def _sync_monitors(self, *_args):
        current = [
            self.monitors.get_item(i)
            for i in range(self.monitors.get_n_items())
        ]

        # Remove windows whose output disappeared.
        kept = []
        for monitor, window in self.windows:
            if monitor in current:
                kept.append((monitor, window))
            else:
                window.close()
        self.windows = kept

        # New windows inherit the current mute state rather than always being
        # hidden until the next audio event.
        known = [monitor for monitor, _window in self.windows]
        for monitor in current:
            if monitor not in known:
                window = self._create_window_for_monitor(monitor)
                self.windows.append((monitor, window))
                window.set_visible(self.muted)

    def _show(self):
        self.muted = True
        for _monitor, window in self.windows:
            window.set_visible(True)
        return GLib.SOURCE_CONTINUE

    def _hide(self):
        self.muted = False
        for _monitor, window in self.windows:
            window.set_visible(False)
        return GLib.SOURCE_CONTINUE


if __name__ == "__main__":
    app = MuteIndicator()
    app.run()
