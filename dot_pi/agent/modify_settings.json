// chezmoi:modify-template
/*#- $yapp := includeTemplate "yapp-packages" (dict "names" (list "pi-bash-bg") "chezmoi" .chezmoi) -*/
/*#- $required := printf "[%s]" (trimSuffix "," (trim $yapp)) | fromJson -*/
/*#- if stat (joinPath .chezmoi.homeDir "dev/yapp/packages/jj/package.json") -*/
/*#-   $required = append $required (joinPath .chezmoi.homeDir "dev/yapp/packages/jj") -*/
/*#- end -*/
/*#- $required = concat $required (list "npm:pi-librarian" "npm:pi-github") -*/
{
  /*#- includeTemplate "pick" (dict
    "stdin" .chezmoi.stdin
    "jq" (printf `{
      lastChangelogVersion, enabledModels, defaultProvider, defaultModel,
      defaultThinkingLevel, hideThinkingBlock, compaction, warnings,
      deviceId, trackingId, modelThinkingLevels,
      transport, sessionShareDestination, followUpMode,
      cacheWarming, tuiMode, httpIdleTimeoutMs,
      shellPath, npmCommand, externalEditor, sessionDir, httpProxy,
      "$schema": .["$schema"],
      enableAnalytics, enableInstallTelemetry, enableSkillCommands,
      showCacheMissNotices, collapseChangelog, showHardwareCursor,
      autocompleteMaxVisible, doubleEscapeAction, editorPaddingX, outputPad,
      images, markdown, thinkingBudgets, defaultTools, codemode, branchSummary,
      extensions, skills, prompts, themes,
      terminal: ((.terminal // {}) + {clearOnShrink: true}),
      theme: (.theme // "dark"),
      packages: ((%s + (.packages // [])) | reduce .[] as $p ([]; if any(.[]; . == $p) then . else . + [$p] end))
    }` ($required | toJson))
  ) */
  "defaultProjectTrust": "always",
  "treeFilterMode": "no-tools",
  "shellCommandPrefix": "export PI_ROOT=\"$(dirname \"$(readlink -f \"$(command -v pi)\")\")/..\"",
  "quietStartup": true,
  "steeringMode": "all",
  "retry": {
    "enabled": true,
    "maxRetries": 64,
    "baseDelayMs": 2000,
    "maxAgentDelayMs": 300000,
    "provider": {
      "maxRetryDelayMs": 0
    }
  }
}
